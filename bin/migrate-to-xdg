#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: migrate-to-xdg [--legacy-dir PATH] [--dry-run]

Copy a legacy Nolendar installation into XDG Base Directory locations.

Options:
  --legacy-dir PATH  Directory containing nolendar.yml, .env, and .nolendar/
                     (default: current working directory)
  --dry-run          Report what would change without writing destination files
  -h, --help         Show this help

Existing destination files are never overwritten unless their contents already
match. Legacy source files are left in place for rollback.
EOF
}

legacy_dir="$PWD"
dry_run=false

while (($# > 0)); do
  case "$1" in
    --legacy-dir)
      if (($# < 2)); then
        echo "--legacy-dir requires a path." >&2
        exit 2
      fi
      legacy_dir="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "${HOME:-}" || "$HOME" != /* ]]; then
  echo "HOME must be set to an absolute path." >&2
  exit 2
fi

absolute_xdg_home() {
  local candidate="$1"
  local fallback="$2"

  if [[ "$candidate" == /* ]]; then
    printf '%s\n' "$candidate"
  else
    printf '%s\n' "$fallback"
  fi
}

xdg_config_home="$(absolute_xdg_home "${XDG_CONFIG_HOME:-}" "$HOME/.config")"
xdg_data_home="$(absolute_xdg_home "${XDG_DATA_HOME:-}" "$HOME/.local/share")"
xdg_state_home="$(absolute_xdg_home "${XDG_STATE_HOME:-}" "$HOME/.local/state")"

config_dir="$xdg_config_home/nolendar"
data_dir="$xdg_data_home/nolendar"
state_dir="$xdg_state_home/nolendar"

legacy_config="$legacy_dir/nolendar.yml"
legacy_env="$legacy_dir/.env"
legacy_state="$legacy_dir/.nolendar/state.json"
legacy_token_cache="$HOME/.nolendar/msal-cache.json"

config_path="$config_dir/config.yml"
env_path="$config_dir/env"
state_path="$state_dir/state.json"
token_cache_path="$data_dir/msal-cache.json"

temporary_config=""
cleanup() {
  if [[ -n "$temporary_config" && -e "$temporary_config" ]]; then
    rm -f -- "$temporary_config"
  fi
}
trap cleanup EXIT

if [[ -f "$legacy_config" ]]; then
  temporary_config="$(mktemp "${TMPDIR:-/tmp}/nolendar-config.XXXXXX")"
  awk '
    !/^[[:space:]]*statePath:[[:space:]]*["\047]?(\.\/)?\.nolendar\/state\.json["\047]?[[:space:]]*(#.*)?$/
  ' "$legacy_config" > "$temporary_config"
fi

preflight() {
  local source="$1"
  local candidate="$2"
  local destination="$3"

  if [[ ! -f "$source" ]]; then
    return
  fi

  if [[ -f "$destination" ]] && cmp -s -- "$candidate" "$destination"; then
    return
  fi

  if [[ -e "$destination" ]]; then
    echo "Refusing to overwrite conflicting destination: $destination" >&2
    echo "Move or reconcile that file, then run the migration again." >&2
    exit 1
  fi
}

migrate_file() {
  local source="$1"
  local candidate="$2"
  local destination="$3"
  local label="$4"

  if [[ ! -f "$source" ]]; then
    echo "Skipping $label; legacy source not found: $source"
    return
  fi

  if [[ -f "$destination" ]] && cmp -s -- "$candidate" "$destination"; then
    if [[ "$dry_run" == false ]]; then
      chmod 600 "$destination"
    fi
    echo "$label already up to date: $destination"
    return
  fi

  if [[ "$dry_run" == true ]]; then
    echo "Would migrate $label: $source -> $destination"
    return
  fi

  install -m 600 "$candidate" "$destination"
  echo "Migrated $label: $source -> $destination"
}

config_candidate="${temporary_config:-$legacy_config}"

# Check every destination before writing any of them, avoiding partial migrations.
preflight "$legacy_config" "$config_candidate" "$config_path"
preflight "$legacy_env" "$legacy_env" "$env_path"
preflight "$legacy_state" "$legacy_state" "$state_path"
preflight "$legacy_token_cache" "$legacy_token_cache" "$token_cache_path"

if [[ "$dry_run" == false ]]; then
  install -d -m 700 "$config_dir" "$data_dir" "$state_dir"
fi

migrate_file "$legacy_config" "$config_candidate" "$config_path" "config"
migrate_file "$legacy_env" "$legacy_env" "$env_path" "environment"
migrate_file "$legacy_state" "$legacy_state" "$state_path" "sync state"
migrate_file "$legacy_token_cache" "$legacy_token_cache" "$token_cache_path" "Microsoft token cache"

if [[ "$dry_run" == true ]]; then
  echo "Dry run complete; no destination files were written."
else
  echo "Migration complete. Legacy source files were left in place for rollback."
fi
